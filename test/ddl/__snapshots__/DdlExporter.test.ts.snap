// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DdlExporter > CREATE DATABASE / USER / SCHEMA > mysql snapshot 1`] = `
"CREATE DATABASE IF NOT EXISTS \`shop\` CHARACTER SET utf8mb4 COLLATE utf8mb4_ja_0900_as_cs;
-- MySQL: replace the password 'change_me' before running
CREATE USER IF NOT EXISTS 'app'@'%' IDENTIFIED BY 'change_me';
GRANT ALL PRIVILEGES ON \`shop\`.* TO 'app'@'%';
USE \`shop\`;"
`;

exports[`DdlExporter > CREATE DATABASE / USER / SCHEMA > oracle snapshot 1`] = `
"-- Oracle: the character set (e.g. AL32UTF8) is chosen when the database itself is created
-- Oracle: replace the password 'change_me' before running
CREATE USER sales IDENTIFIED BY "change_me" QUOTA UNLIMITED ON USERS;
GRANT CREATE SESSION, CREATE TABLE, CREATE SEQUENCE, CREATE VIEW TO sales;
ALTER SESSION SET CURRENT_SCHEMA = sales;"
`;

exports[`DdlExporter > CREATE DATABASE / USER / SCHEMA > postgresql snapshot 1`] = `
"-- PostgreSQL: replace the password 'change_me' before running
CREATE ROLE "app" WITH LOGIN PASSWORD 'change_me';
CREATE DATABASE "shop"
  WITH OWNER "app"
  ENCODING 'UTF8'
  LC_COLLATE 'ja_JP.UTF-8'
  LC_CTYPE 'ja_JP.UTF-8'
  TEMPLATE template0;
-- PostgreSQL: connect to "shop" before running the rest (psql: \\c shop)
CREATE SCHEMA IF NOT EXISTS "sales" AUTHORIZATION "app";
SET search_path TO "sales";"
`;

exports[`DdlExporter > CREATE DATABASE / USER / SCHEMA > sqlite snapshot 1`] = `"PRAGMA encoding = 'UTF-8';"`;

exports[`DdlExporter > CREATE DATABASE / USER / SCHEMA > sqlserver snapshot 1`] = `
"-- SQL Server: replace the password 'change_me' before running
CREATE LOGIN [app] WITH PASSWORD = 'change_me';
GO
CREATE DATABASE [shop] COLLATE Japanese_XJIS_140_CI_AS;
GO
USE [shop];
GO
CREATE USER [app] FOR LOGIN [app];
ALTER ROLE db_owner ADD MEMBER [app];
GO
CREATE SCHEMA [sales] AUTHORIZATION [app];
GO
ALTER USER [app] WITH DEFAULT_SCHEMA = [sales];
GO"
`;

exports[`DdlExporter > mysql: default (plain) DDL snapshot 1`] = `
"CREATE TABLE \`users\` (
  \`id\` INT AUTO_INCREMENT NOT NULL,
  \`name\` VARCHAR(100) NOT NULL,
  \`active\` TINYINT(1) DEFAULT 1 NOT NULL,
  PRIMARY KEY (\`id\`)
);

CREATE TABLE \`profiles\` (
  \`user_id\` INT NOT NULL,
  \`bio\` VARCHAR(100),
  PRIMARY KEY (\`user_id\`)
);

CREATE TABLE \`orders\` (
  \`id\` INT AUTO_INCREMENT NOT NULL,
  \`user_id\` INT NOT NULL,
  \`total\` DECIMAL(10,2) NOT NULL,
  PRIMARY KEY (\`id\`)
);

CREATE TABLE \`order_items\` (
  \`order_id\` INT NOT NULL,
  \`product_id\` INT NOT NULL,
  PRIMARY KEY (\`order_id\`, \`product_id\`)
);

CREATE TABLE \`products\` (
  \`id\` INT AUTO_INCREMENT NOT NULL,
  PRIMARY KEY (\`id\`)
);

ALTER TABLE \`profiles\`
  ADD CONSTRAINT \`fk_profile_user\`
  FOREIGN KEY (\`user_id\`)
  REFERENCES \`users\` (\`id\`);

ALTER TABLE \`orders\`
  ADD CONSTRAINT \`fk_order_user\`
  FOREIGN KEY (\`user_id\`)
  REFERENCES \`users\` (\`id\`);

ALTER TABLE \`order_items\`
  ADD CONSTRAINT \`fk_item_order\`
  FOREIGN KEY (\`order_id\`)
  REFERENCES \`orders\` (\`id\`);

ALTER TABLE \`order_items\`
  ADD CONSTRAINT \`fk_order_items_product_id\`
  FOREIGN KEY (\`product_id\`)
  REFERENCES \`products\` (\`id\`);

CREATE INDEX \`ix_items_product\` ON \`order_items\` (\`product_id\`);"
`;

exports[`DdlExporter > mysql: detailed DDL snapshot 1`] = `
"CREATE TABLE \`users\` (
  \`id\` INT AUTO_INCREMENT NOT NULL,
  \`name\` VARCHAR(100) NOT NULL COMMENT 'ユーザー名: display name, can''t be empty',
  \`active\` TINYINT(1) DEFAULT 1 NOT NULL,
  PRIMARY KEY (\`id\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='ユーザー';

CREATE TABLE \`profiles\` (
  \`user_id\` INT NOT NULL,
  \`bio\` VARCHAR(100) NULL,
  PRIMARY KEY (\`user_id\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE \`orders\` (
  \`id\` INT AUTO_INCREMENT NOT NULL,
  \`user_id\` INT NOT NULL,
  \`total\` DECIMAL(10,2) NOT NULL,
  PRIMARY KEY (\`id\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE \`order_items\` (
  \`order_id\` INT NOT NULL,
  \`product_id\` INT NOT NULL,
  PRIMARY KEY (\`order_id\`, \`product_id\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE \`products\` (
  \`id\` INT AUTO_INCREMENT NOT NULL,
  PRIMARY KEY (\`id\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

ALTER TABLE \`profiles\`
  ADD CONSTRAINT \`fk_profile_user\`
  FOREIGN KEY (\`user_id\`)
  REFERENCES \`users\` (\`id\`);

ALTER TABLE \`orders\`
  ADD CONSTRAINT \`fk_order_user\`
  FOREIGN KEY (\`user_id\`)
  REFERENCES \`users\` (\`id\`);

ALTER TABLE \`order_items\`
  ADD CONSTRAINT \`fk_item_order\`
  FOREIGN KEY (\`order_id\`)
  REFERENCES \`orders\` (\`id\`);

ALTER TABLE \`order_items\`
  ADD CONSTRAINT \`fk_order_items_product_id\`
  FOREIGN KEY (\`product_id\`)
  REFERENCES \`products\` (\`id\`);

CREATE INDEX \`ix_items_product\` ON \`order_items\` (\`product_id\`);"
`;

exports[`DdlExporter > oracle: default (plain) DDL snapshot 1`] = `
"CREATE TABLE users (
  id NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY NOT NULL,
  name VARCHAR2(100 CHAR) NOT NULL,
  active NUMBER(1) DEFAULT 1 NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE profiles (
  user_id NUMBER(10) NOT NULL,
  bio VARCHAR2(100 CHAR),
  PRIMARY KEY (user_id)
);

CREATE TABLE orders (
  id NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY NOT NULL,
  user_id NUMBER(10) NOT NULL,
  total NUMBER(10,2) NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE order_items (
  order_id NUMBER(10) NOT NULL,
  product_id NUMBER(10) NOT NULL,
  PRIMARY KEY (order_id, product_id)
);

CREATE TABLE products (
  id NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY NOT NULL,
  PRIMARY KEY (id)
);

ALTER TABLE profiles
  ADD CONSTRAINT fk_profile_user
  FOREIGN KEY (user_id)
  REFERENCES users (id);

ALTER TABLE orders
  ADD CONSTRAINT fk_order_user
  FOREIGN KEY (user_id)
  REFERENCES users (id);

ALTER TABLE order_items
  ADD CONSTRAINT fk_item_order
  FOREIGN KEY (order_id)
  REFERENCES orders (id);

ALTER TABLE order_items
  ADD CONSTRAINT fk_order_items_product_id
  FOREIGN KEY (product_id)
  REFERENCES products (id);

CREATE INDEX ix_items_product ON order_items (product_id);"
`;

