## Relations

```ermd-relations
- id: profile_user
  fromTableId: t_users
  fromColumnId: u_id
  toTableId: t_profiles
  toColumnId: p_user
  cardinality: ONE_TO_ONE
  hasForeignKey: true
  constraintName: fk_profile_user
  comment: ''
- id: order_user
  fromTableId: t_users
  fromColumnId: u_id
  toTableId: t_orders
  toColumnId: o_user
  cardinality: ONE_TO_MANY
  hasForeignKey: true
  constraintName: fk_order_user
  comment: ''
- id: item_order
  fromTableId: t_orders
  fromColumnId: o_id
  toTableId: t_items
  toColumnId: i_order
  cardinality: ONE_TO_MANY
  hasForeignKey: true
  constraintName: fk_item_order
  comment: ''
- id: item_product
  fromTableId: t_products
  fromColumnId: pr_id
  toTableId: t_items
  toColumnId: i_product
  cardinality: ONE_TO_MANY
  hasForeignKey: true
  constraintName: ''
  comment: ''
```

