name: shop
schema: app
user: app_user
options:
  mysql:
    charset: utf8mb4
```

## Dictionary

```ermd-dictionary
- id: d_id
  name: ID
  dbType: INT
  length: null
  notNull: true
  comment: ''
- id: d_name
  name: Name
  dbType: VARCHAR
  length: 100
  notNull: true
  comment: ''
- id: d_money
  name: Amount
  dbType: DECIMAL
  length: 10
  scale: 2
  notNull: true
  comment: ''
- id: d_flag
  name: Flag
  dbType: BOOLEAN
  length: null
  notNull: true
  comment: ''
```

