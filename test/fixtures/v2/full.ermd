## Tables

```ermd-table
id: t_users
logicalName: ユーザー
physicalName: users
comment: ''
columns:
  - id: u_id
    physicalName: id
    dictionaryId: d_id
    logicalName: id
    isPrimaryKey: true
    isNullable: false
    defaultValue: null
    comment: ''
  - id: u_name
    physicalName: name
    dictionaryId: d_name
    logicalName: ユーザー名
    isPrimaryKey: false
    isNullable: false
    defaultValue: null
    comment: display name, can't be empty
  - id: u_active
    physicalName: active
    dictionaryId: d_flag
    logicalName: active
    isPrimaryKey: false
    isNullable: false
    defaultValue: 'TRUE'
    comment: ''
  - id: u_created
    physicalName: created_at
    dictionaryId: d_name
    logicalName: created_at
    isPrimaryKey: false
    isNullable: false
    defaultValue: null
    comment: ''
    columnSet:
      setId: cset_audit
      columnId: cs_created
columnSetIds:
  - cset_audit
seedData:
  - id: '1'
    name: Alice
    active: 'TRUE'
    created_at: '2026-01-01'
```

