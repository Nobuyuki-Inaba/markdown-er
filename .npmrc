# Supply-chain hardening — see "Dependencies" in CLAUDE.md
# Never run install/postinstall scripts of packages (the most common attack vector)
ignore-scripts=true
# Only install versions published at least 7 days ago (most malicious releases are pulled within days)
min-release-age=7
# No dependencies fetched from git repositories
allow-git=none
# Record exact versions in package.json
save-exact=true
