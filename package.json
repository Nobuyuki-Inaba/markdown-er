{
  "name": "markdown-er",
  "displayName": "Markdown ER Diagram",
  "description": "%description%",
  "version": "0.0.4",
  "publisher": "nobuyuki-inaba",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nobuyuki-Inaba/markdown-er.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:ermd"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ermd",
        "extensions": [
          ".ermd"
        ],
        "aliases": [
          "ER Diagram",
          "ermd"
        ]
      }
    ],
    "commands": [
      {
        "command": "markdown-er.openDiagram",
        "title": "%command.openDiagram%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "markdown-er.exportDdl",
        "title": "%command.exportDdl%"
      },
      {
        "command": "markdown-er.exportDdlDiff",
        "title": "%command.exportDdlDiff%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdown-er.openDiagram",
          "when": "resourceLangId == ermd",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdown-er.openDiagram",
          "when": "resourceExtname == .ermd",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown ER Diagram",
      "properties": {
        "markdown-er.ddl.dialect": {
          "type": "string",
          "enum": [
            "mysql",
            "postgresql",
            "oracle",
            "sqlserver",
            "sqlite"
          ],
          "enumDescriptions": [
            "MySQL / MariaDB",
            "PostgreSQL",
            "Oracle Database (12c+)",
            "Microsoft SQL Server / Azure SQL",
            "SQLite"
          ],
          "default": "mysql",
          "description": "%config.dialect%"
        },
        "markdown-er.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.mcp%"
        },
        "markdown-er.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "日本語"
          ],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --target=node20",
    "build:webview": "cd webview && npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
