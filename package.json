{
  "name": "markdown-er",
  "displayName": "Markdown ER Diagram",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "nobuyuki-inaba",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nobuyuki-Inaba/markdown-er.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:ermd"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ermd",
        "extensions": [
          ".ermd"
        ],
        "aliases": [
          "ER Diagram",
          "ermd"
        ]
      }
    ],
    "commands": [
      {
        "command": "markdown-er.openDiagram",
        "title": "%command.openDiagram%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "markdown-er.exportDdl",
        "title": "%command.exportDdl%"
      },
      {
        "command": "markdown-er.exportDdlDiff",
        "title": "%command.exportDdlDiff%"
      },
      {
        "command": "markdown-er.migrateFile",
        "title": "%command.migrateFile%"
      },
      {
        "command": "markdown-er.migrateWorkspace",
        "title": "%command.migrateWorkspace%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdown-er.openDiagram",
          "when": "resourceLangId == ermd",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdown-er.openDiagram",
          "when": "resourceExtname == .ermd",
          "group": "navigation"
        },
        {
          "command": "markdown-er.migrateFile",
          "when": "resourceExtname == .ermd",
          "group": "markdown-er@1"
        }
      ]
    },
    "configuration": {
      "title": "Markdown ER Diagram",
      "properties": {
        "markdown-er.ddl.dialect": {
          "type": "string",
          "enum": [
            "mysql",
            "postgresql",
            "oracle",
            "sqlserver",
            "sqlite"
          ],
          "enumDescriptions": [
            "MySQL / MariaDB",
            "PostgreSQL",
            "Oracle Database (12c+)",
            "Microsoft SQL Server / Azure SQL",
            "SQLite"
          ],
          "default": "mysql",
          "description": "%config.dialect%"
        },
        "markdown-er.ddl.comments": {
          "type": "boolean",
          "default": false,
          "description": "%config.ddl.comments%"
        },
        "markdown-er.ddl.tableOptions": {
          "type": "boolean",
          "default": false,
          "description": "%config.ddl.tableOptions%"
        },
        "markdown-er.ddl.explicitNull": {
          "type": "boolean",
          "default": false,
          "description": "%config.ddl.explicitNull%"
        },
        "markdown-er.ddl.quoteIdentifiers": {
          "type": "boolean",
          "default": true,
          "description": "%config.ddl.quoteIdentifiers%"
        },
        "markdown-er.ddl.outputFile": {
          "type": "string",
          "default": "${fileBasenameNoExtension}.sql",
          "markdownDescription": "%config.ddl.outputFile%"
        },
        "markdown-er.ddl.dataOutputFile": {
          "type": "string",
          "default": "${fileBasenameNoExtension}_data.sql",
          "markdownDescription": "%config.ddl.dataOutputFile%"
        },
        "markdown-er.markdown.generateMermaid": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.markdown.generateMermaid%"
        },
        "markdown-er.markdown.generateTableDocs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.markdown.generateTableDocs%"
        },
        "markdown-er.migration.prompt": {
          "type": "string",
          "enum": [
            "ask",
            "never"
          ],
          "enumDescriptions": [
            "%config.migration.prompt.ask%",
            "%config.migration.prompt.never%"
          ],
          "default": "ask",
          "markdownDescription": "%config.migration.prompt%"
        },
        "markdown-er.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.mcp%"
        },
        "markdown-er.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "日本語"
          ],
          "default": "auto",
          "description": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --target=node20",
    "build:webview": "cd webview && npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "notices": "node scripts/make-notices.mjs",
    "vscode:prepublish": "npm run build && npm run notices",
    "package": "vsce package",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.41",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "js-yaml": "4.3.2"
  }
}
